# Copy to .env. All keys are optional; features needing a missing key stay off.
PORT=8787
DATA_DIR=./data
GOOGLE_MAPS_API_KEY=
CESIUM_ION_TOKEN=

# ---- Feeds ---------------------------------------------------------------
# Feeds to run in the background (history accumulates while the server runs).
FEEDS=flights,vessels
# Days of history to keep. Global feeds can use several GB per day; see below.
HISTORY_DAYS=7

# Flights. With OpenSky OAuth client credentials the whole world is polled
# (default every 90 s, within the 4000 credits/day budget). Without them,
# adsb.lol is polled within 250 nm of ADSB_AREAS and of recently viewed areas.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# OPENSKY_POLL_S=90
# Semicolon-separated lat,lon pairs, e.g. 37.62,-122.38;51.47,-0.45
ADSB_AREAS=
# ADSB_AREA_POLL_S=30
# ADSB_MIL_POLL_S=30
# Minimum seconds between stored points per aircraft (moving).
# Global OpenSky at 60 s is roughly 3 GB/day; 180 s halves it.
# FLIGHTS_STORE_INTERVAL_S=60

# Ships (AISStream websocket; free key at aisstream.io).
AISSTREAM_API_KEY=
# Restrict to boxes to cut volume, e.g. [[[-90,-180],[90,180]]]
# AISSTREAM_BOUNDING_BOXES=
# VESSELS_STORE_INTERVAL_S=300
# AISSTREAM_SILENCE_TIMEOUT_S=120
